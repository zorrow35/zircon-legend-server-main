function editMap(mapIndex) {
    isCreateMode = false;
    document.getElementById('mapForm').action = '/Maps?handler=UpdateMap';

    // Update modal style
    document.getElementById('mapModalHeader').className = 'modal-header bg-primary text-white';
    document.getElementById('mapModalTitle').innerHTML = '<i class="bi bi-pencil"></i> 编辑地图';
    document.getElementById('mapSubmitBtn').innerHTML = '<i class="bi bi-check-lg"></i> 保存修改';

    // Fetch map details
    fetch(`/Maps?handler=MapDetail&mapIndex=${mapIndex}`)
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                const data = result.data;
                // Fill form
                document.getElementById('editMapIndex').value = data.index;
                document.getElementById('editFileName').value = data.fileName;
                document.getElementById('editDescription').value = data.description;
                document.getElementById('editMiniMap').value = data.miniMap;
                document.getElementById('editSkillDelay').value = data.skillDelay;
                document.getElementById('editLight').value = data.light;
                document.getElementById('editFight').value = data.fight;
                document.getElementById('editMinimumLevel').value = data.minimumLevel;
                document.getElementById('editMaximumLevel').value = data.maximumLevel;
                document.getElementById('editAllowRT').checked = data.allowRT;
                document.getElementById('editAllowTT').checked = data.allowTT;
                document.getElementById('editCanHorse').checked = data.canHorse;
                document.getElementById('editCanMine').checked = data.canMine;
                document.getElementById('editCanMarriageRecall').checked = data.canMarriageRecall;
                document.getElementById('editAllowRecall').checked = data.allowRecall;
                document.getElementById('editMonsterHealth').value = data.monsterHealth;
                document.getElementById('editMaxMonsterHealth').value = data.maxMonsterHealth;
                document.getElementById('editMonsterDamage').value = data.monsterDamage;
                document.getElementById('editMaxMonsterDamage').value = data.maxMonsterDamage;
                document.getElementById('editDropRate').value = data.dropRate;
                document.getElementById('editMaxDropRate').value = data.maxDropRate;
                document.getElementById('editExperienceRate').value = data.experienceRate;
                document.getElementById('editMaxExperienceRate').value = data.maxExperienceRate;
                document.getElementById('editGoldRate').value = data.goldRate;
                document.getElementById('editMaxGoldRate').value = data.maxGoldRate;

                // Show modal
                new bootstrap.Modal(document.getElementById('mapModal')).show();
            } else {
                ToastManager.error('加载地图信息失败: ' + result.message);
            }
        })
        .catch(error => {
            ToastManager.error('请求失败: ' + error.message);
        });
}

// ==================== 地图怪物管理功能 ====================

let currentMapIndex = 0;
let currentMapName = "";

// 管理地图怪物
function manageMapMonsters(mapIndex, mapName) {
    currentMapIndex = mapIndex;
    currentMapName = mapName;

    document.getElementById('mapMonstersModalTitle').textContent = `地图怪物管理: ${mapName}`;
    document.getElementById('regionSelect').innerHTML = '<option value="">-- 请选择区域 --</option>';
    document.getElementById('monstersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mb-0 mt-2">加载区域列表中...</p></td></tr>';
    document.getElementById('currentRegionInfo').style.display = 'none';

    new bootstrap.Modal(document.getElementById('mapMonstersModal')).show();

    // 加载地图区域列表
    fetch(`/Maps?handler=MapRegions&mapIndex=${mapIndex}`)
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                const select = document.getElementById('regionSelect');
                select.innerHTML = '<option value="">-- 请选择区域 --</option>';
                result.data.forEach(region => {
                    const option = document.createElement('option');
                    option.value = region.regionIndex;
                    option.textContent = `${region.description} (大小: ${region.size})`;
                    select.appendChild(option);
                });

                document.getElementById('monstersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><i class="bi bi-inbox display-6"></i><p class="mb-0 mt-2">请选择区域查看怪物列表</p></td></tr>';
            } else {
                document.getElementById('monstersTableBody').innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle display-6"></i><p class="mb-0 mt-2">${escapeHtml(result.message)}</p></td></tr>`;
            }
        })
        .catch(error => {
            document.getElementById('monstersTableBody').innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle display-6"></i><p class="mb-0 mt-2">请求失败: ${escapeHtml(error.message)}</p></td></tr>`;
        });
}

// 加载区域怪物列表
function loadRegionMonsters() {
    const regionIndex = document.getElementById('regionSelect').value;
    if (!regionIndex) {
        document.getElementById('monstersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><i class="bi bi-inbox display-6"></i><p class="mb-0 mt-2">请选择区域查看怪物列表</p></td></tr>';
        document.getElementById('currentRegionInfo').style.display = 'none';
        return;
    }

    document.getElementById('addRegionIndex').value = regionIndex;
    document.getElementById('monstersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mb-0 mt-2">加载怪物列表中...</p></td></tr>';

    fetch(`/Maps?handler=RegionMonsters&regionIndex=${regionIndex}`)
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                document.getElementById('currentRegionName').textContent = result.regionName;
                document.getElementById('currentRegionInfo').style.display = 'block';
                renderMonsterTable(result.data);
            } else {
                document.getElementById('monstersTableBody').innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle display-6"></i><p class="mb-0 mt-2">${escapeHtml(result.message)}</p></td></tr>`;
                document.getElementById('currentRegionInfo').style.display = 'none';
            }
        })
        .catch(error => {
            document.getElementById('monstersTableBody').innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle display-6"></i><p class="mb-0 mt-2">请求失败: ${escapeHtml(error.message)}</p></td></tr>`;
            document.getElementById('currentRegionInfo').style.display = 'none';
        });
}

// 渲染怪物表格
function renderMonsterTable(monsters) {
    const tbody = document.getElementById('monstersTableBody');

    if (!monsters || monsters.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><i class="bi bi-inbox display-6"></i><p class="mb-0 mt-2">该区域没有怪物配置</p></td></tr>';
        document.getElementById('totalMonsters').textContent = '0';
        document.getElementById('monsterCountBadge').textContent = '0';
        return;
    }

    tbody.innerHTML = monsters.map(m => {
        const eventBadge = m.eventSpawn ? '<span class="badge bg-warning text-dark">活动</span>' : '';
        const announceBadge = m.announce ? '<span class="badge bg-info">公告</span>' : '';

        return `<tr data-respawn-index="${m.respawnIndex}">
                <td>
                    <strong>${escapeHtml(m.monsterName)}</strong>
                </td>
                <td>${m.monsterLevel}</td>
                <td>${m.delay}秒</td>
                <td>${m.count}</td>
                <td>${m.dropSet > 0 ? `<span class="badge bg-secondary">${m.dropSet}</span>` : '-'}</td>
                <td>${eventBadge} ${announceBadge}</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-warning" onclick="editMonster(${m.respawnIndex})" title="编辑">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="deleteMonster(${m.respawnIndex})" title="删除">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>`;
    }).join('');

    document.getElementById('totalMonsters').textContent = monsters.length;
    document.getElementById('monsterCountBadge').textContent = monsters.length;
}

// 搜索怪物
function searchMonsters() {
    const keyword = document.getElementById('monsterSearchInput').value.trim();
    fetch(`/Maps?handler=MonstersList&keyword=${encodeURIComponent(keyword)}`)
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                const select = document.getElementById('monsterSelect');
                select.innerHTML = '<option value="">-- 选择怪物 --</option>';
                result.data.forEach(m => {
                    const option = document.createElement('option');
                    option.value = m.index;
                    option.textContent = `${m.name} (Lv.${m.level})`;
                    select.appendChild(option);
                });
            }
        })
        .catch(error => {
            ToastManager.error('搜索怪物失败: ' + error.message);
        });
}

// 提交添加怪物表单
document.addEventListener('DOMContentLoaded', function() {
    const addMonsterForm = document.getElementById('addMonsterForm');
    if (addMonsterForm) {
        addMonsterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(addMonsterForm);
            formData.append('handler', 'AddMonster');

            fetch('/Maps', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    ToastManager.success(result.message);
                    addMonsterForm.reset();
                    // 重新加载当前区域的怪物列表
                    loadRegionMonsters();
                } else {
                    ToastManager.error(result.message);
                }
            })
            .catch(error => {
                ToastManager.error('添加失败: ' + error.message);
            });
        });
    }

    // 编辑怪物表单
    const editMonsterForm = document.getElementById('editMonsterForm');
    if (editMonsterForm) {
        editMonsterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(editMonsterForm);

            fetch('/Maps', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    ToastManager.success(result.message);
                    bootstrap.Modal.getInstance(document.getElementById('editMonsterModal')).hide();
                    // 重新加载当前区域的怪物列表
                    loadRegionMonsters();
                } else {
                    ToastManager.error(result.message);
                }
            })
            .catch(error => {
                ToastManager.error('保存失败: ' + error.message);
            });
        });
    }
});

// 编辑怪物
function editMonster(respawnIndex) {
    const row = document.querySelector(`[data-respawn-index="${respawnIndex}"]`);
    if (!row) return;

    document.getElementById('editRespawnIndex').value = respawnIndex;
    document.getElementById('editMonsterName').value = row.cells[0].textContent.trim();

    // 从行数据中提取信息
    const delayText = row.cells[2].textContent.replace('秒', '');
    const countText = row.cells[3].textContent;
    const dropSetText = row.cells[4].textContent.trim();

    document.getElementById('editDelay').value = delayText;
    document.getElementById('editCount').value = countText;
    document.getElementById('editDropSet').value = dropSetText === '-' ? '0' : dropSetText;

    new bootstrap.Modal(document.getElementById('editMonsterModal')).show();
}

// 删除怪物
function deleteMonster(respawnIndex) {
    const row = document.querySelector(`[data-respawn-index="${respawnIndex}"]`);
    const monsterName = row ? row.cells[0].textContent.trim() : '该怪物';

    if (!confirm(`确定要删除 ${monsterName} 吗？`)) {
        return;
    }

    const formData = new FormData();
    formData.append('handler', 'DeleteMonster');
    formData.append('respawnIndex', respawnIndex);

    fetch('/Maps', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            ToastManager.success(result.message);
            // 重新加载当前区域的怪物列表
            loadRegionMonsters();
        } else {
            ToastManager.error(result.message);
        }
    })
    .catch(error => {
        ToastManager.error('删除失败: ' + error.message);
    });
}

// HTML转义函数
function escapeHtml(value) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    return String(value ?? '').replace(/[&<>"']/g, (m) => map[m]);
}
